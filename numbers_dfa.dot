digraph "numbers" {
  rankdir=LR;
  node [shape=circle];
  __start [shape=point];
  __start -> S0;
  S1 [shape=doublecircle, label="S1\nINT"];
  S2 [shape=doublecircle, label="S2\nINT"];
  S4 [shape=doublecircle, label="S4\nBAD_NUMBER"];
  S5 [shape=doublecircle, label="S5\nBAD_NUMBER"];
  S6 [shape=doublecircle, label="S6\nFLOAT"];
  S7 [shape=doublecircle, label="S7\nINT"];
  S8 [shape=doublecircle, label="S8\nBAD_NUMBER"];
  S10 [shape=doublecircle, label="S10\nFLOAT"];
  S0 -> S1 [label="0"];
  S0 -> S2 [label="1-9"];
  S1 -> S3 [label="."];
  S1 -> S2 [label="0-9"];
  S1 -> S4 [label="прочие"];
  S1 -> S5 [label="X,x"];
  S2 -> S3 [label="."];
  S2 -> S2 [label="0-9"];
  S2 -> S4 [label="прочие"];
  S3 -> S6 [label="0-9"];
  S4 -> S4 [label="прочие"];
  S5 -> S7 [label="0-9,A-F,a-f"];
  S5 -> S4 [label="прочие"];
  S6 -> S6 [label="0-9"];
  S6 -> S4 [label="прочие"];
  S6 -> S8 [label="E,e"];
  S7 -> S7 [label="0-9,A-F,a-f"];
  S7 -> S4 [label="прочие"];
  S8 -> S9 [label="+,-"];
  S8 -> S10 [label="0-9"];
  S8 -> S4 [label="прочие"];
  S9 -> S10 [label="0-9"];
  S10 -> S10 [label="0-9"];
  S10 -> S4 [label="прочие"];
}